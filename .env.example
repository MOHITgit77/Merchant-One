# ShopFlow Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/shopflow
DATABASE_USERNAME=shopflow
DATABASE_PASSWORD=shopflow

# JWT
JWT_SECRET=your-secret-key-that-is-at-least-256-bits-long-for-hs256-algorithm

# File Storage
FILE_STORAGE_LOCATION=./uploads

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080
